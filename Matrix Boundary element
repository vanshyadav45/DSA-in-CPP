class Solution {
  public:
    vector<int> boundaryTraversal(vector<vector<int>>& mat) {
        // code here
        vector<int> arr;
        int r = mat.size();
        int c = mat[0].size();
        
       if(r==1){
           for (int j = 0; j < c; j++) {
            arr.push_back(mat[0][j]);
        }
        return arr;
           
       }
       if(c==1){
           for (int i = 0; i < r; i++) {
            arr.push_back(mat[i][0]);
        }
        return arr;
       }
        
        for (int j = 0; j < c; j++) {
            arr.push_back(mat[0][j]);
        }
       
        
        
        for (int i = 1; i < r; i++) {
            arr.push_back(mat[i][c - 1]);
        }
        
        
        for (int j = c - 2; j >= 0; j--) {
            arr.push_back(mat[r - 1][j]);
        }
        
        
        for (int i = r - 2; i >= 1; i--) {
            arr.push_back(mat[i][0]);
        }
       
        
        return arr;
    }
};
