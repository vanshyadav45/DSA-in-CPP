//To print snake pattern in matrix

class Solution {
  public:
    vector<int> snakePattern(vector<vector<int> > matrix) {
        int m = matrix.size();
        int n = matrix[0].size();
        vector<int> result;
        
        for(int i = 0; i < m; i++) {
            if(i % 2 == 0) {
                // Even rows: left to right
                for(int j = 0; j < n; j++) {
                    result.push_back(matrix[i][j]);
                }
            } else {
                // Odd rows: right to left
                for(int j = n - 1; j >= 0; j--) {
                    result.push_back(matrix[i][j]);
                }
            }
        }
        
        return result;
    }
};
